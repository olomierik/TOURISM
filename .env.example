# ---------------------------------------------------------------------------
# Explore Tanzania — environment variables
# Copy to `.env` and fill in. `.env` is git-ignored and must stay that way.
# ---------------------------------------------------------------------------

# --- Database (Phase 1) -----------------------------------------------------
# Supabase Postgres connection string. Port 5432 = session mode (migrations,
# scripts). Use port 6543 for transaction-mode pooling from serverless runtimes.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-eu-west-1.pooler.supabase.com:5432/postgres

# --- Supabase API (Phase 2 — auth, storage) ---------------------------------
# Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Browser-side key. Safe to expose: it is RLS-constrained and can only reach what
# the policies allow. Supabase's current format is sb_publishable_...; older
# projects issue a JWT-style anon key instead. Either works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Bypasses Row Level Security entirely — never prefix with
# NEXT_PUBLIC_, never send to the browser, never commit. Current format is
# sb_secret_...; older projects call this the service_role key.
SUPABASE_SECRET_KEY=

# --- Site (SEO) -------------------------------------------------------------
# Canonical origin used for canonical URLs, hreflang and the sitemap.
# Falls back to the Vercel deploy URL, then localhost. Required for production
# builds (scripts/check-env.mjs): sign-up confirmation links are built from it.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Google sign-in on our own domain (optional) ------------------------------
# With both set, Google's screen names this site instead of <project>.supabase.co
# (lib/auth/google.ts). Same OAuth client as the Supabase Google provider, with
# <origin>/auth/google/callback added as a redirect URI. Server-only: never
# prefix with NEXT_PUBLIC_. Without them, Google goes through Supabase's flow.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Reminder emails (app/api/cron/reminders) ------------------------------
# Shared with the hourly Netlify scheduled function netlify/functions/reminders.mjs.
# At least 16 random characters. Without it the reminder endpoint is off.
CRON_SECRET=

# --- Email notifications (Phase 4) ------------------------------------------
# Optional in development: without a key the app uses a console-logging provider
# so every lead flow still works end to end.
RESEND_API_KEY=
# Transactional mail: lead notifications to operators, claim alerts to admins.
# This one has to arrive — it is the revenue path.
EMAIL_FROM=Explore Tanzania <notifications@exploretanzania.online>
# Cold outreach gets its own identity, so complaints against it do not quietly
# degrade delivery of the notifications above. Falls back to EMAIL_FROM.
OUTREACH_FROM=Explore Tanzania <listings@exploretanzania.online>
# Where "remove" replies land. The outreach body promises a human reads this,
# so it must forward to an inbox somebody opens.
OUTREACH_REPLY_TO=listings@exploretanzania.online
# Signing secret (whsec_…) of the Resend webhook pointed at /api/webhooks/resend
# for email.bounced, email.complained and email.suppressed. Hard bounces and
# complaints are then suppressed automatically. Unset, the route answers 503.
RESEND_WEBHOOK_SECRET=

# --- Payments — Flutterwave (Phase 8) ---------------------------------------
# Cards plus M-Pesa / Tigo Pesa / Airtel Money. Left blank, the mock provider
# is used so subscription flows remain testable locally.
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_ENCRYPTION_KEY=
FLUTTERWAVE_WEBHOOK_HASH=

# --- Payments — Paddle -------------------------------------------------------
# A second rail, not a replacement. Paddle is Merchant of Record: it registers
# for and remits sales tax and VAT in 300+ markets, invoices, and absorbs
# chargebacks, which Flutterwave does not. In exchange it is cards only — no
# M-Pesa, Tigo Pesa or Airtel Money — and it cannot bill in TZS or KES at all,
# so a Paddle plan is a USD plan. Fee is 5% + 50c per transaction.
#
# Before any of this works, in the Paddle dashboard:
#   1. My account > Settings > Website approval — add the domain, wait for a
#      human to approve it.
#   2. Checkout > Checkout configuration > Default payment link — set it to
#      https://<domain>/pay (the page is app/[locale]/pay). Transactions cannot
#      be created at all until this is set.
#   3. Events > Notifications — add a webhook destination pointing at
#      /api/payments/paddle/webhook, subscribed to transaction.completed, and
#      copy its secret key (pdl_ntfset_...) into PADDLE_WEBHOOK_SECRET.
#
# Verified end to end on a sandbox account, 9 November 2026:
#   - The API key needs only transaction read+write and product+price write.
#     The inline non-catalog items createCheckout() builds are rejected without
#     the product and price scopes, and nothing needs any of the others.
#   - Sandbox approves a domain the moment you add it; live is a human review
#     and wants terms, privacy and refunds reachable on the site (we have all
#     three under /legal).
#   - `localhost` is REJECTED as an approved domain — Paddle wants a real
#     hostname — but Paddle.js still opens a sandbox checkout on
#     http://localhost:3000/pay, so local testing works without approving
#     anything. The default payment link has to be a real approved domain.
#   - PAYMENTS_PROVIDER may be left unset: paddle is the default rail
#     (see lib/payments/provider.ts).
#
# Left blank, Paddle counts as unconfigured: /pay says so and checkout falls
# back to Flutterwave.
#
# Sandbox and live are two named sets, and which one is in force is NOT an
# environment variable any more. It is the `paddle_live` row in
# platform_settings, flipped from Admin > Settings, so going live takes effect
# on the next request instead of needing a rebuild (migration 085 says why).
#
# The sandbox set still reads the three unsuffixed names below when the
# _SANDBOX ones are absent, so an existing environment keeps working untouched.
# The live set has no such fallback on purpose: these unsuffixed variables
# hold sandbox keys in every environment of this project, and falling back to
# them would mean "live" quietly kept using the test gateway.
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
# The only Paddle credential the browser sees. Publishable by design.
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
#
# Live. Required before the admin toggle will switch to live at all, and
# checked by prefix as well as presence — a sandbox key in a _LIVE variable is
# rejected rather than used, because that exact mix-up has happened here.
#   PADDLE_API_KEY_LIVE        pdl_live_...
#   PADDLE_CLIENT_TOKEN_LIVE   live_...
#   PADDLE_WEBHOOK_SECRET_LIVE pdl_ntfset_... (from the LIVE dashboard, which
#                              is a different secret from the sandbox one)
PADDLE_API_KEY_LIVE=
PADDLE_WEBHOOK_SECRET_LIVE=
PADDLE_CLIENT_TOKEN_LIVE=
#
# Sandbox, optional. Set these to keep both sets side by side; otherwise the
# three unsuffixed variables above serve as the sandbox set.
PADDLE_API_KEY_SANDBOX=
PADDLE_WEBHOOK_SECRET_SANDBOX=
PADDLE_CLIENT_TOKEN_SANDBOX=
#
# Deprecated and no longer read: the mode lives in platform_settings now.
# Left here only so an existing .env does not look like it is missing a line.
PADDLE_ENV=sandbox

# Which rail the subscription checkout uses: 'flutterwave' or 'paddle'.
# Unset means paddle, Erick's decision on 2026-11-09. There is no fallback to
# the other rail: when the selected one cannot take a payment, checkout reports
# itself unavailable rather than quietly charging through an account nobody is
# reconciling. See lib/payments/provider.ts.
PAYMENTS_PROVIDER=

# --- Google AdSense (Phase 8; owner's steps in docs/ADS.md) ------------------
# One ad on every page, last in the content column, below everything that can
# be pressed. The quote funnel, account pages and the legal pages stay ad-free
# by design — a qualified safari lead is worth far more than an ad click, and
# an ad beside those controls would poach it. lib/ads.ts holds the route list.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
# The switch: no ad code loads unless this is "true". It also needs
# NEXT_PUBLIC_ALLOW_INDEXING=true — ads on a site nobody can find earn nothing
# and only risk a policy flag.
NEXT_PUBLIC_ADS_ENABLED=
# The site-wide unit (Ads -> By ad unit -> Display ads). Required: without it
# no ad renders anywhere, whatever the switch says.
NEXT_PUBLIC_ADSENSE_SLOT_DEFAULT=
# Optional extra units for the pages long enough to carry a second one. Each
# falls back to the default above when left empty.
NEXT_PUBLIC_ADSENSE_SLOT_GUIDE=
NEXT_PUBLIC_ADSENSE_SLOT_DESTINATION=
NEXT_PUBLIC_ADSENSE_SLOT_DIRECTORY=

# --- Viator affiliate links (optional) ----------------------------------------
# Partner ID from the Viator Partner Program dashboard (looks like P00012345).
# Destination pages show a "More tours on Viator" link once it is set.
NEXT_PUBLIC_VIATOR_PID=
# Campaign value from the same dashboard; 42383 when empty.
NEXT_PUBLIC_VIATOR_MCID=

# --- Search engine indexing ------------------------------------------------
# OFF by default. Organic search is the growth channel, so the first crawl
# matters: a site indexed while routes are still placeholders teaches Google it
# is thin, and that judgement outlives the placeholders. Set to "true" only when
# real listings and guides are live on the canonical domain.
NEXT_PUBLIC_ALLOW_INDEXING=false

# --- The brand's own profiles (optional) -----------------------------------
# Comma-separated absolute URLs of accounts that are this organisation:
# a Facebook page, an Instagram profile, a LinkedIn company page, a YouTube
# channel. They become `sameAs` in the Organization structured data, which is
# how an entity tells a search engine which accounts are it.
#
# This matters for one query in particular. `explore tanzania` drew 247
# impressions and 2 clicks in Search Console to 5 November 2026: the site is
# not first for its own name. No established operator owns the exact phrase, so
# it is winnable, and it is the only keyword on the site where a ranking gain
# converts at once, because the searcher already typed the name.
#
# Leave empty rather than guessing. An unset value omits the field; a URL that
# does not resolve to a profile this brand controls is a false claim about
# identity, and Google may discount the whole Organization node for it.
NEXT_PUBLIC_SOCIAL_PROFILES=

# --- Google Search Console -------------------------------------------------
# Token from Search Console -> Settings -> Ownership verification -> HTML tag.
# Only the token itself, not the whole <meta> element. Verifying by DNS TXT
# record instead works equally well and needs nothing here.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- Google Maps (optional) -------------------------------------------------
# Server-side Places API key for /api/maps/search. Restrict it by API and by
# server IP in Google Cloud. Without it the maps search returns no results.
GOOGLE_MAPS_API_KEY=
# Browser key for the map widgets. Restrict it by HTTP referrer to your domains.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

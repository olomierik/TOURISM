# ---------------------------------------------------------------------------
# Explore Tanzania — environment variables
# Copy to `.env` and fill in. `.env` is git-ignored and must stay that way.
# ---------------------------------------------------------------------------

# --- Database (Phase 1) -----------------------------------------------------
# Supabase Postgres connection string. Port 5432 = session mode (migrations,
# scripts). Use port 6543 for transaction-mode pooling from serverless runtimes.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-eu-west-1.pooler.supabase.com:5432/postgres

# --- Supabase API (Phase 2 — auth, storage) ---------------------------------
# Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Browser-side key. Safe to expose: it is RLS-constrained and can only reach what
# the policies allow. Supabase's current format is sb_publishable_...; older
# projects issue a JWT-style anon key instead. Either works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Bypasses Row Level Security entirely — never prefix with
# NEXT_PUBLIC_, never send to the browser, never commit. Current format is
# sb_secret_...; older projects call this the service_role key.
SUPABASE_SECRET_KEY=

# --- Site (SEO) -------------------------------------------------------------
# Canonical origin used for canonical URLs, hreflang and the sitemap.
# Falls back to the Vercel deploy URL, then localhost. Required for production
# builds (scripts/check-env.mjs): sign-up confirmation links are built from it.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Google sign-in on our own domain (optional) ------------------------------
# With both set, Google's screen names this site instead of <project>.supabase.co
# (lib/auth/google.ts). Same OAuth client as the Supabase Google provider, with
# <origin>/auth/google/callback added as a redirect URI. Server-only: never
# prefix with NEXT_PUBLIC_. Without them, Google goes through Supabase's flow.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Reminder emails (app/api/cron/reminders) ------------------------------
# Shared with the hourly Netlify scheduled function netlify/functions/reminders.mjs.
# At least 16 random characters. Without it the reminder endpoint is off.
CRON_SECRET=

# --- Email notifications (Phase 4) ------------------------------------------
# Optional in development: without a key the app uses a console-logging provider
# so every lead flow still works end to end.
RESEND_API_KEY=
# Transactional mail: lead notifications to operators, claim alerts to admins.
# This one has to arrive — it is the revenue path.
EMAIL_FROM=Explore Tanzania <notifications@exploretanzania.online>
# Cold outreach gets its own identity, so complaints against it do not quietly
# degrade delivery of the notifications above. Falls back to EMAIL_FROM.
OUTREACH_FROM=Explore Tanzania <listings@exploretanzania.online>
# Where "remove" replies land. The outreach body promises a human reads this,
# so it must forward to an inbox somebody opens.
OUTREACH_REPLY_TO=listings@exploretanzania.online
# Signing secret (whsec_…) of the Resend webhook pointed at /api/webhooks/resend
# for email.bounced, email.complained and email.suppressed. Hard bounces and
# complaints are then suppressed automatically. Unset, the route answers 503.
RESEND_WEBHOOK_SECRET=

# --- Payments — Flutterwave (Phase 8) ---------------------------------------
# Cards plus M-Pesa / Tigo Pesa / Airtel Money. Left blank, the mock provider
# is used so subscription flows remain testable locally.
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_ENCRYPTION_KEY=
FLUTTERWAVE_WEBHOOK_HASH=

# --- Google AdSense (Phase 8; owner's steps in docs/ADS.md) ------------------
# Guides, destination pages and the directory results only. Business profiles,
# packages and the quote funnel stay ad-free by design — a qualified safari lead
# is worth far more than an ad click, and ads there would poach it.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
# The switch: no ad code loads unless this is "true".
NEXT_PUBLIC_ADS_ENABLED=
# One ad unit ID per placement (Ads -> By ad unit -> Display ads).
NEXT_PUBLIC_ADSENSE_SLOT_GUIDE=
NEXT_PUBLIC_ADSENSE_SLOT_DESTINATION=
NEXT_PUBLIC_ADSENSE_SLOT_DIRECTORY=

# --- Viator affiliate links (optional) ----------------------------------------
# Partner ID from the Viator Partner Program dashboard (looks like P00012345).
# Destination pages show a "More tours on Viator" link once it is set.
NEXT_PUBLIC_VIATOR_PID=
# Campaign value from the same dashboard; 42383 when empty.
NEXT_PUBLIC_VIATOR_MCID=

# --- Search engine indexing ------------------------------------------------
# OFF by default. Organic search is the growth channel, so the first crawl
# matters: a site indexed while routes are still placeholders teaches Google it
# is thin, and that judgement outlives the placeholders. Set to "true" only when
# real listings and guides are live on the canonical domain.
NEXT_PUBLIC_ALLOW_INDEXING=false

# --- Google Search Console -------------------------------------------------
# Token from Search Console -> Settings -> Ownership verification -> HTML tag.
# Only the token itself, not the whole <meta> element. Verifying by DNS TXT
# record instead works equally well and needs nothing here.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- Google Maps (optional) -------------------------------------------------
# Server-side Places API key for /api/maps/search. Restrict it by API and by
# server IP in Google Cloud. Without it the maps search returns no results.
GOOGLE_MAPS_API_KEY=
# Browser key for the map widgets. Restrict it by HTTP referrer to your domains.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
